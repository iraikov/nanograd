;;;; -*- Hen -*-

(
 ; Your egg's license:
 (license "LGPL-3")

 ; Egg category
 (category math)

 ; A list of eggs nanograd depends on.
 ; array-morphisms-blas (not 'blas' directly) provides the system-BLAS-backed
 ; array-morphisms-blas-egg-backend module used by some of the array-morphisms
 ; example/benchmark scripts (e.g. examples/bench-am-cnn-ssa.scm);
 ; none of nanograd's own components import it directly.
 (dependencies test srfi-1 srfi-4 srfi-42 srfi-69
               mathh vector-lib yasos s11n array-morphisms)

 (author "Ivan Raikov")

 (synopsis "Minimalistic automatic differentiation framework.")

 (components (extension nanograd-autograd (source "autograd.scm")
                        (csc-options "-O3" "-d1"))
             (extension nanograd-layer (source "layer.scm")
                        (csc-options "-O3" "-d1")
                        (component-dependencies nanograd-autograd))
             (extension nanograd-optimizer (source "optimizer.scm")
                        (csc-options "-O3" "-d1")
                        (component-dependencies nanograd-autograd))
             (extension nanograd-diagnostics (source "gradient-diagnostics.scm")
                        (csc-options "-O3" "-d1")
                        (component-dependencies nanograd-autograd))
             (extension nanograd-training (source "training.scm")
                        (csc-options "-O3" "-d1")
                        (component-dependencies nanograd-autograd))
             (extension nanograd-array-morphisms
                        (source "array-morphisms-nanograd.scm")
                        (csc-options "-O2" "-d1")
                        (component-dependencies nanograd-autograd nanograd-layer))
             )

 (test-dependencies test)

)
